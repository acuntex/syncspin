{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "cargo *": "allow",
      "scripts/*": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git merge-base *": "allow",
      "git ls-files *": "allow",
      "git for-each-ref *": "allow",
      "git write-tree *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git rm *": "allow",
      "git mv *": "allow",
      "git restore *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "chmod +x *": "allow",
      "git push *": "deny",
      "git commit *--no-verify*": "deny",
      "git commit *--no-v*": "deny",
      "git diff *--output*": "deny",
      "git log *--output*": "deny",
      "git show *--output*": "deny",
      "git commit -n*": "deny",
      "git commit * -n": "deny",
      "git commit * -n *": "deny",
      "git config *": "deny",
      "git -c *": "deny",
      "git -C *": "deny",
      "git reset --hard *": "deny",
      "gh pr merge *": "deny",
      "gh pr *--auto*": "deny",
      "gh api *": "deny",
      "gh repo *": "deny",
      "gh workflow *": "deny",
      "gh release *": "deny",
      "gh auth *": "deny",
      "bash -c *": "deny",
      "sh -c *": "deny",
      "env *": "deny",
      "python* *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny"
    },
    "edit": "allow",
    "external_directory": "ask"
  }
}
