{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "gh pr merge *": "deny",
      "gh pr *--auto*": "deny",
      "git push * main*": "deny",
      "git push *:main*": "deny",
      "git push *refs/heads/main*": "deny",
      "git push *--force*": "deny",
      "git push -f *": "deny",
      "git push *--mirror*": "deny",
      "git push *--delete*": "deny",
      "git push --no-verify*": "deny",
      "git commit *--no-verify*": "deny",
      "git commit *--no-v*": "deny",
      "git commit -n*": "deny",
      "git commit * -n": "deny",
      "git commit * -n *": "deny"
    }
  }
}
