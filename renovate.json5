{
  // Dependency automation for syncspin. Renovate reads this file from the
  // default branch (`main`); the Dependency Dashboard issue is the single place
  // where approval-gated updates are approved or declined.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    // Rewrites `uses: owner/action@v4` into a commit SHA, keeping the tag as a
    // trailing comment. `.github/workflows/ci.yml` pins actions by tag on
    // purpose; this preset turns them into digests on its first run.
    "helpers:pinGitHubActionDigests",
  ],

  // Keep the PR queue reviewable: at most five dependency PRs open at once.
  prConcurrentLimit: 5,

  packageRules: [
    {
      // Non-major cargo updates arrive as one weekly PR, so the review is one
      // changelog read instead of ten. Majors and pins stay separate.
      matchManagers: ["cargo"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "cargo non-major",
      schedule: ["before 06:00 on monday"],
    },
    {
      // Action bumps are one PR a week and carry the tag-to-SHA pinning from
      // `helpers:pinGitHubActionDigests` above.
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      schedule: ["before 06:00 on monday"],
    },
    {
      // Automerge only where CI is the whole contract: test harnesses and the
      // shared version pins, on patch and minor updates. The cargo manager
      // reports `depType` as the literal Cargo section name, so these are
      // `dev-dependencies` and `workspace.dependencies` - never the npm-style
      // `devDependencies`. Third-party versions live in
      // `[workspace.dependencies]` here, which is why that section is included;
      // the crypto crates are pulled back out by the rule below.
      matchManagers: ["cargo"],
      matchDepTypes: ["dev-dependencies", "workspace.dependencies"],
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
    },
    {
      // Crypto, hashing and the async runtime decide the MSRV (1.85) and,
      // through `snow` and `x25519-dalek`, the wire protocol. These are never
      // automerged and their PR is only opened after approval on the Dependency
      // Dashboard, so a human reads the changelog and the ARMv7 impact first.
      // Listed last so this rule wins over the grouping and automerge rules
      // above (they are declared in `[workspace.dependencies]`, so the
      // automerge rule would otherwise match them), and with its own group so
      // approval does not block the weekly cargo PR.
      matchManagers: ["cargo"],
      matchPackageNames: [
        "snow",
        "x25519-dalek",
        "sha2",
        "hmac",
        "tokio",
        "tokio-tungstenite",
      ],
      groupName: "cargo crypto and runtime (manual review)",
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // Three updates in the weekly group declare Rust 1.88 against this
      // workspace's MSRV of 1.85: sha2 0.11 (which pulls digest 0.11), hmac
      // 0.13 (which needs that digest), and proptest 1.12. The rule there is to
      // pin rather than accept, so the bounds below stop the group from
      // re-proposing a migration the toolchain refuses. Lift them when the MSRV
      // moves.
      matchManagers: ["cargo"],
      matchPackageNames: ["sha2"],
      allowedVersions: "<0.11.0",
    },
    {
      matchManagers: ["cargo"],
      matchPackageNames: ["hmac"],
      allowedVersions: "<0.13.0",
    },
    {
      matchManagers: ["cargo"],
      matchPackageNames: ["proptest"],
      allowedVersions: "<1.12.0",
    },
  ],
}
